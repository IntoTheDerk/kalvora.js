{
  "name": "kalvora-proto",
  "version": "1.0.0",
  "description": "Kalvora wire protocol definitions (synchronised from kalvora-indexer) and TypeScript codegen",
  "type": "module",
  "files": [
    "*.proto",
    "buf.yaml",
    "buf.gen.yaml",
    "build.ts",
    "LICENSE",
    "NOTICE"
